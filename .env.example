# Server runtime configuration. Set hosted values in Vercel (Project → Settings →
# Environment Variables). Locally, copy this file to .env.local (ignored by Git)
# or run `vercel env pull .env.local`. Never add real credentials to this example.

# Supabase. The Supabase integration on the Vercel Marketplace sets these names
# automatically; set them by hand if you connect an existing project instead.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: private photo storage and account deletion.
SUPABASE_SERVICE_ROLE_KEY=
# Transaction pooler connection string (port 6543). DATABASE_URL wins if both are set.
POSTGRES_URL=

# Optional Claude extraction, plain-English search, summaries and moderation.
# Without this key, submitted contributions are held for moderation.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Optional; leave blank unless your Anthropic account requires a workspace.
ANTHROPIC_WORKSPACE_ID=

# Server-only Google Places API (New) and Map Tiles API access.
GOOGLE_MAPS_API_KEY=

# Public Union scraping remains off until the operator checks permission/terms.
UNION_IMPORT_ENABLED=false

# Union events and freebies share batches of up to 30 for extraction + moderation.
# Unchanged source/model/policy fingerprints reuse saved AI results.
# Legacy Jev settings are retained for compatibility but ignored by this importer.
FREEBIE_JEV_SCREENING=false
JEV_API_KEY=
JEV_MODEL=jev-latest
JEV_THRESHOLD=0.5
# Optional importer override; defaults to claude-haiku-5-5 independently of ANTHROPIC_MODEL.
FREEBIE_CLAUDE_MODEL=

# Background continuation. Generate a random secret of at least 32 characters.
# Set a trusted, reachable URL for THIS environment; never point preview at production.
CRON_SECRET=
FREEBIE_WORKER_URL=
# Example: https://your-campus-site.vercel.app/api/freebies/worker
# vercel.json registers 05:00 UTC daily; imports stay off until explicitly enabled.
FREEBIE_DAILY_IMPORT_ENABLED=false

# Comma-separated Supabase Auth user IDs permitted to moderate and import events.
ADMIN_USER_IDS=
