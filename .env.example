# Server runtime configuration. Set hosted values through Sites secrets.
# Never add real credentials to source or the hosting manifest.

# UCL email-code delivery; EMAIL_FROM must be verified with Resend.
RESEND_API_KEY=
EMAIL_FROM=

# Optional Claude extraction, plain-English search, summaries and moderation.
# Without this key, submitted contributions are held for moderation.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Server-only Google Places API (New) and Map Tiles API access.
GOOGLE_MAPS_API_KEY=

# Public Union scraping remains off until the operator checks permission/terms.
UNION_IMPORT_ENABLED=false

# Comma-separated Sites user IDs permitted to moderate and import events.
ADMIN_USER_IDS=

# Cloudflare D1 DB and R2 BUCKET bindings are provisioned by Sites.

