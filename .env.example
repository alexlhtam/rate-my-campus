# Server runtime configuration. Set hosted values in Vercel (Project → Settings →
# Environment Variables). Locally, copy this file to .env.local (ignored by Git)
# or run `vercel env pull .env.local`. Never add real credentials to this example.

# Supabase. The Supabase integration on the Vercel Marketplace sets these names
# automatically; set them by hand if you connect an existing project instead.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: private photo storage and account deletion.
SUPABASE_SERVICE_ROLE_KEY=
# Transaction pooler connection string (port 6543). DATABASE_URL wins if both are set.
POSTGRES_URL=

# Optional Claude extraction, plain-English search, summaries and moderation.
# Without this key, submitted contributions are held for moderation.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Optional; leave blank unless your Anthropic account requires a workspace.
ANTHROPIC_WORKSPACE_ID=

# Server-only Google Places API (New) and Map Tiles API access.
GOOGLE_MAPS_API_KEY=

# Public Union scraping remains off until the operator checks permission/terms.
UNION_IMPORT_ENABLED=false

# Comma-separated Supabase Auth user IDs permitted to moderate and import events.
ADMIN_USER_IDS=
